{
  "name": "agri-eng-mono",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @heji/web",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @heji/web",
    "preview:web": "npm run preview --workspace @heji/web",
    "typecheck": "npm run typecheck --workspace @heji/web",
    "test": "npm run test --workspace @heji/web",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "prepare": "simple-git-hooks",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check"
  }
}
